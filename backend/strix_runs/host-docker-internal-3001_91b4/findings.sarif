          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "IDOR: Any authenticated user can read any other user's shopping basket (GET /rest/basket/:id)\n\nThe `GET /rest/basket/:id` endpoint returns any user's shopping basket to any authenticated customer. The server validates the JWT but never checks that the requested basket ID belongs to the token's user, allowing a logged-in customer to enumerate and read every other user's basket, including current product selections, quantities, and prices."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SECURITY.md"
                }
