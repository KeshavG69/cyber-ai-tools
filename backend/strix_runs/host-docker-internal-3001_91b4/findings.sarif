          "ruleId": "vuln-0014",
          "ruleIndex": 9,
          "level": "warning",
          "message": {
            "text": "SSRF with response disclosure via /profile/image/url imageUrl fetch\n\nThe profile image URL upload feature accepts a user-supplied `imageUrl` and performs a server-side `fetch()` of that URL with no allowlist, scheme, or IP-range validation. Any authenticated user can make the application server issue HTTP requests to arbitrary internal or external destinations, and the fetched response body is persisted and retrievable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "SECURITY.md"
                }
              }
            },
            {
              "logicalLocations": [
