          "partialFingerprints": {
            "primaryLocationLineHash": "e0203d218af92fa4925668b5d528e7c9634d228ac512f99090069facb6daa792"
          },
          "properties": {
            "security-severity": "4.3",
            "strix_vuln_class_hash": "ebf1ba63c404f36a89caddaa6fe5f69242fcb30f0ba18d9b0a595b1226f560fa",
