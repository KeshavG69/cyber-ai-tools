# SoldierIQ Cyber — local environment.
# Copy this file to `.env` and fill in your values. `.env` is gitignored — never commit it.

# --- LLM for the pentest engine (required to launch scans) ---
STRIX_LLM=openrouter/z-ai/glm-5.3
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
# For a LOCAL model instead (e.g. Ollama / vLLM on Orionhub), leave LLM_API_KEY empty and set:
# LLM_API_BASE=http://localhost:11434/v1

# --- Dashboard login (HTTP basic-auth) ---
DASH_USER=admin
DASH_PASSWORD=change-me
